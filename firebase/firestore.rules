// Copy of the Firestore rules Su pasted in the Firebase console (project app-vault-962b9 > Firestore > Rules).
// SU_EMAIL = the email of Su's Email/Password user (kept out of this public repo). Change both copies together.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSu() {
      return request.auth != null
        && request.auth.token.email == 'SU_EMAIL'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    match /members/{uid} {
      allow read: if isSu() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 80
        && request.resource.data.keys().hasOnly(['name', 'note', 'device', 'status', 'created']);
      // An approved person may only report which apps they have (App Vault 0.25.0+)
      allow update: if isSu() || (request.auth != null && request.auth.uid == uid
        && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apps', 'page', 'seen'])
        && request.resource.data.apps is map
        && request.resource.data.apps.size() <= 50
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 20);
      // Join Beta / Leave Beta (App Vault page 0.34.0+): a person may only ask to join, or leave. Su approves ('yes') in Studio.
      allow update: if request.auth != null && request.auth.uid == uid
        && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['beta'])
        && request.resource.data.beta in ['asked', 'no'];
      allow delete: if isSu();
    }
    function approved() {
      return request.auth != null
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'approved';
    }
    // Notes and bug reports from App Vault app pages (App Vault 0.29.0+)
    match /reports/{rid} {
      allow read: if isSu() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.photos is int
        && request.resource.data.photos <= 4
        && request.resource.data.keys().hasOnly(['uid', 'name', 'app', 'appName', 'version', 'page', 'device', 'text', 'photos', 'status', 'created']);
      // The writer may only mark a reply as read, or reopen it by writing back (App Vault 0.31.0+)
      allow update: if isSu() || (request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastAt', 'userUnread'])
        && request.resource.data.status in ['new', resource.data.status]
        && request.resource.data.userUnread == false);
      allow delete: if isSu();
      // The chat under each message: Su's replies and the writer's answers.
      // Both sides may add one photo (JPEG data URL) or one small file (App Vault page 0.33.0+, Studio 0.18.0+).
      function okAttach() {
        let d = request.resource.data;
        return (!('photo' in d) || (d.photo is string && d.photo.size() <= 900000))
          && (!('file' in d) || (d.file is map && d.file.keys().hasOnly(['name', 'type', 'data'])
            && d.file.name is string && d.file.name.size() <= 200
            && d.file.type is string && d.file.type.size() <= 200
            && d.file.data is string && d.file.data.size() <= 960000));
      }
      match /msgs/{mid} {
        allow read: if isSu() || (request.auth != null && get(/databases/$(database)/documents/reports/$(rid)).data.uid == request.auth.uid);
        allow create: if (isSu() && request.resource.data.from == 'su'
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
            && okAttach())
          || (approved() && request.resource.data.from == 'user'
            && request.resource.data.uid == request.auth.uid
            && get(/databases/$(database)/documents/reports/$(rid)).data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && okAttach()
            && request.resource.data.keys().hasOnly(['from', 'uid', 'text', 'created', 'photo', 'file']));
        allow delete: if isSu();
      }
      match /photos/{pid} {
        allow read: if isSu() || (request.auth != null && resource.data.uid == request.auth.uid);
        allow create: if approved()
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/reports/$(rid)).data.uid == request.auth.uid
          && pid in ['0', '1', '2', '3']
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 900000
          && request.resource.data.keys().hasOnly(['uid', 'data']);
        allow delete: if isSu();
      }
    }
  }
}
